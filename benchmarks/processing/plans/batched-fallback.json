{
  "round_offset": 0,
  "rounds": 3,
  "clients": 2,
  "seconds": 60,
  "warmup_seconds": 60,
  "warmup_requests": 256,
  "timeout_seconds": 120,
  "ready_timeout_seconds": 300,
  "prepare_timeout_seconds": 900,
  "max_start_lateness_ms": 20,
  "concurrency": [
    4
  ],
  "session": "batched-fallback",
  "variants": [
    {
      "name": "gpu-batched-frontend",
      "prepare_argv": [
        "python3",
        "/store/tools/hook.py",
        "gpu-batched-frontend"
      ],
      "spec": {
        "protocol": "rest",
        "url": "http://mlserver-rfdetr.mlserver-perf.svc:8080/v2/models/rfdetr-small-batched/infer",
        "payloads": [
          "/store/payloads/triton-binary-rest.bin"
        ],
        "headers": {
          "Content-Type": "application/octet-stream",
          "Inference-Header-Content-Length": "225"
        },
        "min_response_bytes": 100000
      }
    },
    {
      "name": "gpu-batched-worker",
      "prepare_argv": [
        "python3",
        "/store/tools/hook.py",
        "gpu-batched-worker"
      ],
      "spec": {
        "protocol": "rest",
        "url": "http://mlserver-rfdetr.mlserver-perf.svc:8080/v2/models/rfdetr-small-batched/infer",
        "payloads": [
          "/store/payloads/triton-binary-rest.bin"
        ],
        "headers": {
          "Content-Type": "application/octet-stream",
          "Inference-Header-Content-Length": "225"
        },
        "min_response_bytes": 100000
      }
    }
  ]
}