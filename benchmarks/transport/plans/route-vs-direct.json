{
  "round_offset": 0,
  "rounds": 3,
  "clients": 2,
  "seconds": 60,
  "warmup_seconds": 60,
  "warmup_requests": 256,
  "timeout_seconds": 120,
  "ready_timeout_seconds": 300,
  "prepare_timeout_seconds": 900,
  "max_start_lateness_ms": 20,
  "concurrency": [
    1,
    8,
    16
  ],
  "session": "route-vs-direct",
  "variants": [
    {
      "name": "route-direct",
      "prepare_argv": [
        "python3",
        "/store/tools/hook.py",
        "route-direct"
      ],
      "spec": {
        "protocol": "rest",
        "url": "http://mlserver-rfdetr.mlserver-perf.svc:8080/v2/models/rfdetr-small/infer",
        "payloads": [
          "/store/payloads/triton-binary-rest.bin"
        ],
        "headers": {
          "Content-Type": "application/octet-stream",
          "Inference-Header-Content-Length": "225"
        },
        "min_response_bytes": 100000
      }
    },
    {
      "name": "route-edge-tls",
      "prepare_argv": [
        "python3",
        "/store/tools/hook.py",
        "route-edge-tls"
      ],
      "spec": {
        "protocol": "rest",
        "url": "https://mlserver-rfdetr-mlserver-perf.apps.REPLACE-ME.example.com:443/v2/models/rfdetr-small/infer",
        "payloads": [
          "/store/payloads/triton-binary-rest.bin"
        ],
        "headers": {
          "Content-Type": "application/octet-stream",
          "Inference-Header-Content-Length": "225"
        },
        "min_response_bytes": 100000
      }
    }
  ]
